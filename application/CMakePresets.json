{
    "version": 2,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 20
    },
    "configurePresets": [
        {
            "name": "build",
            "displayName": "Build for Bare Metal nRF54L15 DK nRF54L15 Application S115 SoftDevice",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build",
            "cacheVariables": {
                "BOARD": "bm_nrf54l15dk/nrf54l15/cpuapp/s115_softdevice",
                "CONF_FILE": "prj.conf",
                "DEBUG_THREAD_INFO": true,
                "CONFIG_DEBUG_THREAD_INFO": true,
                "application_DEBUG_THREAD_INFO": true,
                "softdevice_DEBUG_THREAD_INFO": false
            }
        }
    ]
}